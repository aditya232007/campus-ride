<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep Midnight Royal Navy Canvas -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="315"
                android:startColor="#050914"
                android:centerColor="#0B1528"
                android:endColor="#0F1F38"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Ambient Center Electric Blue Radial Glow -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48"
                android:startColor="#2A00F0FF"
                android:centerColor="#181D4ED8"
                android:endColor="#00050914"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Subtle Connected Grid / Geometric Tech Grid Accent -->
    <path
        android:pathData="M24,78 L84,78 M30,84 L78,84 M38,90 L70,90"
        android:strokeColor="#1E3A8A"
        android:strokeAlpha="0.3"
        android:strokeWidth="0.8" />

    <!-- Dynamic Neon Cyan Motion & Route Curve (Representing GPS Connectivity & Mobility) -->
    <path
        android:pathData="M14,84 C30,76 42,74 54,74 C66,74 78,76 94,84"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:angle="0"
                android:startColor="#0000F0FF"
                android:centerColor="#00F0FF"
                android:endColor="#0000F0FF"
                android:type="linear" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M24,80 C36,75 45,74 54,74 C63,74 72,75 84,80"
        android:strokeWidth="1.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#E0F2FE"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Futuristic Orbit Pulse Ring (Subtle) -->
    <path
        android:pathData="M54,54 m-36,0 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0"
        android:strokeWidth="1.0"
        android:strokeAlpha="0.18">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:angle="45"
                android:startColor="#00F0FF"
                android:centerColor="#3B82F6"
                android:endColor="#6366F1"
                android:type="linear" />
        </aapt:attr>
    </path>

</vector>

