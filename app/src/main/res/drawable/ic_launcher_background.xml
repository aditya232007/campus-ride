<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Deep Midnight Blue Sky Background (#080C16) -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#080C16" />

    <!-- Dusk Sunset Radial Glow -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="45"
                android:gradientRadius="60"
                android:startColor="#1E2A4A"
                android:endColor="#080C16"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Lime Green Speed Horizon Arc Accent -->
    <path
        android:pathData="M10,85 Q54,78 98,85"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:angle="0"
                android:startColor="#10B981"
                android:centerColor="#84CC16"
                android:endColor="#06B6D4"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
